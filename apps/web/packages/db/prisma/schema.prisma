generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PLUS
  PRO
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum Visibility {
  PRIVATE      // legacy
  TEAM         // legacy
  PUBLIC_LINK  // unlisted, link only
  PUBLIC       // publicly listed with category
  PASSWORD     // link + password required
  NEARBY       // publicly readable; surfaced by proximity instead of category
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackType {
  BUG
  IDEA
  GENERAL
  OTHER
}

enum FeedbackStatus {
  NEW
  READ
  RESOLVED
}

enum ReportTargetType {
  CONTINUUM
  USER
  COMMENT
}

enum ReportCategory {
  SPAM
  HARASSMENT
  HATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

// ─── Auth (NextAuth Prisma Adapter) ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  slogan             String?
  url                String?
  avatarConfig       Json      @default("{}")
  avatarThumbnail    String?   @db.Text
  onboardingComplete Boolean   @default(false)
  stripeCustomerId    String?   @unique
  plan                Plan      @default(FREE)
  isSynthetic         Boolean   @default(false)
  continuumCredits    Int       @default(0)
  lifetimeContinuums  Boolean   @default(false)
  bannedAt            DateTime? // site-wide ban (admins only)
  banReason           String?

  accounts       Account[]
  sessions       Session[]
  continuums     Continuum[]
  memberships    TeamMember[]
  participations ContinuumParticipant[]
  messages       Message[]
  feedback       Feedback[]
  reports        Report[]       @relation("ReportsMade")
  continuumBans  ContinuumBan[] @relation("ContinuumBans")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  members   TeamMember[]
  continuums Continuum[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  userId String
  teamId String
  role   TeamRole @default(MEMBER)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Continuum {
  id          String     @id @default(cuid())
  title       String
  leftLabel   String
  rightLabel  String
  description String?
  ownerId     String
  teamId      String?
  visibility   Visibility @default(PUBLIC_LINK)
  shareToken   String?    @unique
  category     String?
  passwordHash String?

  // Where a NEARBY continuum is pinned. Always coarsened to ~2dp (~0.7 miles) before
  // being written — these sit on a publicly readable record, so they must never
  // hold full GPS precision. Null for every other visibility.
  lat Float?
  lng Float?

  participants ContinuumParticipant[]
  messages     Message[]
  bans         ContinuumBan[]

  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  moderationStatus ModerationStatus @default(APPROVED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  closedAt  DateTime?
  deletedAt DateTime?

  // Supports the bounding-box prefilter behind the "Within 5 miles" listing.
  @@index([lat, lng])
}

model ContinuumParticipant {
  id          String  @id @default(cuid())
  continuumId String
  userId      String
  position    Float   @default(50)  // X position, 0–100 (left to right on continuum)
  positionZ   Float   @default(50)  // Z/depth position, 0–100 (visual only, no semantic meaning)
  comment     String?
  // Reversible comment hide. hiddenBy = "ai" | "owner" | "admin" (the actor).
  commentHidden    Boolean @default(false)
  commentHiddenBy  String?

  continuum Continuum @relation(fields: [continuumId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([continuumId, userId])
}

model Message {
  id          String   @id @default(cuid())
  continuumId String
  userId      String
  body             String           @db.Text
  moderationStatus ModerationStatus @default(APPROVED)

  continuum Continuum @relation(fields: [continuumId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Feedback, reports & moderation ─────────────────────────────────────────

// General site feedback (contact form). May be anonymous (userId null, email optional).
model Feedback {
  id        String         @id @default(cuid())
  type      FeedbackType   @default(GENERAL)
  message   String         @db.Text
  userId    String?
  email     String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// A user flagging a continuum / user / comment. targetSnapshot preserves the
// reported content at report time (comments get edited/deleted).
model Report {
  id             String           @id @default(cuid())
  targetType     ReportTargetType
  targetId       String
  continuumId    String? // context for comment/continuum reports
  targetSnapshot String?          @db.Text
  category       ReportCategory
  note           String?          @db.Text
  reporterId     String
  status         ReportStatus     @default(OPEN)
  resolvedBy     String? // admin email
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId]) // one report per user per target
  @@index([status, category, createdAt])
  @@index([targetType, targetId])
}

// Audit log of admin (and reversible) moderation actions.
model AdminAction {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // e.g. hide_comment, unhide_comment, ban_user, dismiss_report
  targetType String
  targetId   String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A continuum owner banning a user from their continuum (not site-wide).
model ContinuumBan {
  id          String   @id @default(cuid())
  continuumId String
  userId      String
  bannedBy    String // owner userId
  createdAt   DateTime @default(now())

  continuum Continuum @relation(fields: [continuumId], references: [id], onDelete: Cascade)
  user      User      @relation("ContinuumBans", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([continuumId, userId])
}
