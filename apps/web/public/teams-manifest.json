{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "packageName": "com.communiculture.app",
  "developer": {
    "name": "Futurefarmers",
    "websiteUrl": "https://communiculture.com",
    "privacyUrl": "https://communiculture.com/privacy",
    "termsOfUseUrl": "https://communiculture.com/terms"
  },
  "name": {
    "short": "Communiculture",
    "full": "Communiculture — Continuums"
  },
  "description": {
    "short": "Place yourself on a continuum",
    "full": "Run live continuums in your Teams meetings. Participants drag their avatar to show where they stand."
  },
  "icons": {
    "outline": "icon-outline.png",
    "color": "icon-color.png"
  },
  "accentColor": "#0033CC",
  "configurableTabs": [
    {
      "configurationUrl": "https://communiculture.com/teams/config",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupchat"],
      "context": [
        "channelTab",
        "privateChatTab",
        "meetingChatTab",
        "meetingDetailsTab",
        "meetingSidePanel"
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["communiculture.com"]
}
